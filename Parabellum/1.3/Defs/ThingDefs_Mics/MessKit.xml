	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="RangedWeaponRecipeBase">
		<defName>MakePa_MessKit</defName>
		<label>make a Mess Kit</label>
		<description>Make a Mess Kit, an army marches on its stomach.</description>
		<jobString>Making Mess Kit.</jobString>
		<targetCountAdjustment>1</targetCountAdjustment>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>AluminiumBar</li>
					</thingDefs>
				</filter>
				<count>12</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>AluminiumBar</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Pa_MessKitP>1</Pa_MessKitP>
		</products>
		<skillRequirements>
			<Crafting>3</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<li>FabricationBench</li>
		</recipeUsers>
		<researchPrerequisite>Food_B3</researchPrerequisite>
	</RecipeDef>
 
</Defs>